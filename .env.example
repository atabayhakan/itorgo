DATABASE_URL="postgresql://itorgo:itorgo@localhost:5432/itorgo?schema=public"
# Direct URL for Neon branching (optional)
# DATABASE_URL_NON_POOLING=""
NEXTAUTH_SECRET="change-me-in-production"   # signs admin session cookies — generate: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
# Admin panel access (required for /admin). Hash: node scripts/admin-hash.mjs "your-password"
ADMIN_EMAIL="admin@itorgo.kg"
ADMIN_PASSWORD_HASH=""
# Pin admin routes to one host in production (leave empty in dev)
ADMIN_HOST="admin.itorgo.kg"
# Storage (S3-compatible, Neon Object Storage ready)
# S3_BUCKET="itorgo-media"
# S3_REGION="us-east-1"
# Feature providers (optional)
# OPENAI_API_KEY=""
# SMS_PROVIDER_KEY=""
